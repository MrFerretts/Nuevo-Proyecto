# Telegram Bot Token - Obtener de @BotFather en Telegram
BOT_TOKEN=tu_token_aqui

# Tu ID de Telegram (admin del bot) - Obtener de @userinfobot
ADMIN_ID=tu_id_aqui

# ID del canal gratuito (ej: -1001234567890)
FREE_CHANNEL_ID=

# ID del canal premium/VIP (ej: -1001234567890)
VIP_CHANNEL_ID=

# API Key de The Odds API (gratis: 500 requests/mes) - https://the-odds-api.com/
ODDS_API_KEY=tu_api_key_aqui

# API Key de API-Football (gratis: 100 requests/día) - https://www.api-football.com/
FOOTBALL_API_KEY=tu_api_key_aqui

# Precio de suscripción VIP mensual en USD
VIP_PRICE=9.99

# Enlace de pago (PayPal.me, Stripe link, etc.)
PAYMENT_LINK=https://paypal.me/tu_usuario
